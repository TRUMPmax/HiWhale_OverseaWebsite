# ========================================
# Database (PostgreSQL + pgvector)
# ========================================
POSTGRES_USER=hiwhale
POSTGRES_PASSWORD=hiwhale_dev
POSTGRES_DB=hiwhale
POSTGRES_PORT=5432
# Use host.docker.internal from Docker containers on Windows/Mac; use "postgres" service name inside Linux Docker networks
DATABASE_URL=postgresql://hiwhale:hiwhale_dev@localhost:5432/hiwhale

# ========================================
# Redis
# ========================================
REDIS_URL=redis://default:hiwhale_dev@localhost:6379
REDIS_PASSWORD=hiwhale_dev
REDIS_PORT=6379

# ========================================
# MinIO (object storage for images/PDFs/3D models)
# ========================================
MINIO_ROOT_USER=hiwhale
MINIO_ROOT_PASSWORD=hiwhale_dev
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_BUCKET=hiwhale-uploads

# ========================================
# Authentication (NextAuth.js)
# ========================================
AUTH_SECRET=replace_with_strong_random_secret
NEXTAUTH_URL=http://localhost:3000

# ========================================
# AI / RAG
# ========================================
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
EMBEDDING_API_URL=http://localhost:8080
RERANK_API_URL=http://localhost:8080
HF_TOKEN=your_huggingface_token

# ========================================
# App URLs
# ========================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_WEB_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
ADMIN_URL=http://localhost:3001

# ========================================
# SMTP (optional, for notifications)
# ========================================
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@hiwhale.com

# ========================================
# Turnstile / Captcha (optional)
# ========================================
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
