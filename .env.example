# ========================================
# Database (PostgreSQL + pgvector)
# ========================================
POSTGRES_USER=hiwhale
POSTGRES_PASSWORD=hiwhale_dev
POSTGRES_DB=hiwhale
POSTGRES_PORT=5432
# Use host.docker.internal from Docker containers on Windows/Mac; use "postgres" service name inside Linux Docker networks
DATABASE_URL=postgresql://hiwhale:hiwhale_dev@localhost:5432/hiwhale

# ========================================
# Redis（当前代码未消费，预留）
# ========================================
REDIS_URL=redis://default:hiwhale_dev@localhost:6379
REDIS_PASSWORD=hiwhale_dev
REDIS_PORT=6379

# ========================================
# MinIO (object storage for images/PDFs/3D models)
# ========================================
MINIO_ROOT_USER=hiwhale
MINIO_ROOT_PASSWORD=hiwhale_dev
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_BUCKET=hiwhale-uploads
# api 容器内访问 MinIO 的凭据（Docker 部署时 = 上面的 ROOT 账号）
MINIO_ACCESS_KEY=hiwhale
MINIO_SECRET_KEY=hiwhale_dev
# 上传文件的公网访问前缀（生产必须配成可达地址，否则全站上传图 404）
MINIO_PUBLIC_URL=http://localhost:9000/hiwhale-uploads

# ========================================
# Authentication（NestJS JWT）
# ========================================
# 生产必填（api 容器 NODE_ENV=production 下缺失即拒绝启动）：openssl rand -hex 32 生成
JWT_SECRET=
# 首次 seed 超管账号（可选覆盖）
SEED_ADMIN_EMAIL=admin@hiwhale.com
SEED_ADMIN_PASSWORD=

# ========================================
# AI（DeepSeek；RAG 向量服务暂不实装，见 docs/modules/04）
# ========================================
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
EMBEDDING_API_URL=http://localhost:8080
RERANK_API_URL=http://localhost:8080
HF_TOKEN=your_huggingface_token

# ========================================
# App URLs / CORS
# ========================================
# API 服务监听端口
PORT=4000
# API CORS 允许来源（逗号分隔；生产改为正式域名，含 admin 子域）
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# 生产示例：CORS_ORIGINS=https://hiwhalerob.com,https://www.hiwhalerob.com,https://admin.hiwhalerob.com,https://hiwhalerobotics.com,https://www.hiwhalerobotics.com
# 前端构建期变量（Docker 构建经 build args 注入；本地开发用 .env.local）
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_PORTAL_URL=http://localhost:3000

# ========================================
# SMTP（暂不实装：纯海外站注册仅校验邮箱格式，无验证码环节；预留见 docs/modules/02）
# ========================================
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ========================================
# Turnstile / Captcha（暂不实装，预留见 docs/modules/05）
# ========================================
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
