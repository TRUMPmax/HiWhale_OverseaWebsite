// HiWhale 数据库 Schema（PostgreSQL + pgvector）
// 约定：
// - 表名统一 snake_case（@@map）
// - 多语言字段（{en, zh}）与结构化规格使用 Json，与 @hiwhale/shared 的 Mock 类型对应
// - RAG 表含 pgvector 向量列（embedding vector(1024)，bge-m3）与 tsvector 全文检索列
//   （search_vector 由写入时生成填充，见迁移 0001_init）

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- 枚举 ----------

enum UserStatus {
  ACTIVE
  DISABLED
}

// 门户用户角色（当前仅客户） 
enum PortalRole {
  CUSTOMER
}

// 产品上下架状态 
enum ProductStatus {
  ON
  OFF
}

// 内容发布状态（方案/案例） 
enum PublishStatus {
  PUBLISHED
  DRAFT
}

enum InquiryStatus {
  NEW
  FOLLOWING
  WON
  CLOSED
}

// 后台员工角色 
enum StaffRole {
  SUPER_ADMIN
  SALES
  PRODUCT_TECH
  OPERATIONS
}

// 知识库文档向量化状态 
enum VectorStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
}

// ---------- 门户用户 ----------

model User {
  id           String     @id @default(uuid()) @db.Uuid
  email        String     @unique
  passwordHash String     @map("password_hash")
  name         String
  company      String?
  phone        String?
  country      String?
  role         PortalRole @default(CUSTOMER)
  status       UserStatus @default(ACTIVE)
  aiUsageCount Int        @default(0) @map("ai_usage_count")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  conversations ChatConversation[]

  @@map("users")
}

// ---------- 后台员工 ----------

model StaffUser {
  id           String     @id @default(uuid()) @db.Uuid
  email        String     @unique
  passwordHash String     @map("password_hash")
  name         String
  role         StaffRole
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  assignedInquiries Inquiry[]         @relation("InquiryAssignee")
  followUps         InquiryFollowUp[]
  operationLogs     OperationLog[]
  documents         KnowledgeDocument[]

  @@map("staff_users")
}

model OperationLog {
  id        String    @id @default(uuid()) @db.Uuid
  staffId   String    @map("staff_id") @db.Uuid
  staff     StaffUser @relation(fields: [staffId], references: [id], onDelete: Cascade)
  action    String
  target    String
  detail    Json?
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([staffId])
  @@map("operation_logs")
}

// ---------- 产品 / 方案 / 案例 ----------

model Product {
  id          String        @id @default(uuid()) @db.Uuid
  slug        String        @unique
  model       String        @unique
  // 品类（ProductCategory 枚举值） 
  category    String
  // 大类（ProductGroup 枚举值） 
  group       String
  // {en, zh} 
  name        Json
  tagline     Json
  description Json
  quickSpecs  Json          @map("quick_specs")
  specGroups  Json          @map("spec_groups")
  features    Json
  // Industry 枚举值数组 
  scenarios   String[]
  imageName   String        @map("image_name")
  // 已上传素材 URL（MinIO）；为空时前端显示占位块
  imageUrl    String?       @map("image_url")
  specUrl     String?       @map("spec_url")
  modelUrl    String?       @map("model_url")
  status      ProductStatus @default(ON)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  @@index([category])
  @@index([group])
  @@map("products")
}

model Solution {
  id          String        @id @default(uuid()) @db.Uuid
  slug        String        @unique
  // Industry 枚举值 
  industry    String
  title       Json
  summary     Json
  description Json
  painPoints  Json          @map("pain_points")
  // ProductCategory 枚举值数组 
  equipment   String[]
  process     Json
  results     Json
  imageName   String        @map("image_name")
  status      PublishStatus @default(PUBLISHED)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  @@map("solutions")
}

model CaseStudy {
  id          String        @id @default(uuid()) @db.Uuid
  slug        String        @unique
  industry    String
  clientName  Json          @map("client_name")
  project     Json
  background  Json
  challenge   Json
  solution    Json
  equipment   Json
  duration    Json
  results     Json
  testimonial Json
  logoName    String        @map("logo_name")
  imageName   String        @map("image_name")
  status      PublishStatus @default(PUBLISHED)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  @@map("case_studies")
}

// ---------- 询盘 ----------

model Inquiry {
  id          String        @id @default(uuid()) @db.Uuid
  fullName    String        @map("full_name")
  company     String
  email       String
  phone       String?
  country     String
  // ProductCategory 枚举值数组 
  categories  String[]
  description String
  status      InquiryStatus @default(NEW)
  assigneeId  String?       @map("assignee_id") @db.Uuid
  assignee    StaffUser?    @relation("InquiryAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  followUps InquiryFollowUp[]

  @@index([status])
  @@map("inquiries")
}

model InquiryFollowUp {
  id        String    @id @default(uuid()) @db.Uuid
  inquiryId String    @map("inquiry_id") @db.Uuid
  inquiry   Inquiry   @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  authorId  String?   @map("author_id") @db.Uuid
  author    StaffUser? @relation(fields: [authorId], references: [id], onDelete: SetNull)
  note      String
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([inquiryId])
  @@map("inquiry_follow_ups")
}

// ---------- RAG：知识库 ----------

model KnowledgeDocument {
  id            String       @id @default(uuid()) @db.Uuid
  fileName      String       @map("file_name")
  fileType      String       @map("file_type")
  fileUrl       String?      @map("file_url")
  // 关联产品型号（如 MBV15R），通用文档为空 
  productModel  String?      @map("product_model")
  category      String?
  language      String       @default("zh")
  vectorStatus  VectorStatus @default(PENDING) @map("vector_status")
  errorMessage  String?      @map("error_message")
  uploadedById  String?      @map("uploaded_by_id") @db.Uuid
  uploadedBy    StaffUser?   @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  chunks DocumentChunk[]

  @@map("knowledge_documents")
}

model DocumentChunk {
  id            String              @id @default(uuid()) @db.Uuid
  documentId    String              @map("document_id") @db.Uuid
  document      KnowledgeDocument   @relation(fields: [documentId], references: [id], onDelete: Cascade)
  // 父子分块（小块检索、父块返回上下文） 
  parentChunkId String?             @map("parent_chunk_id") @db.Uuid
  parentChunk   DocumentChunk?      @relation("ChunkHierarchy", fields: [parentChunkId], references: [id])
  childChunks   DocumentChunk[]     @relation("ChunkHierarchy")
  chunkIndex    Int                 @map("chunk_index")
  content       String
  contentEn     String?             @map("content_en")
  // bge-m3 向量（1024 维），由迁移启用 pgvector 
  embedding     Unsupported("vector(1024)")?
  // 全文检索向量（写入时生成填充） 
  searchVector  Unsupported("tsvector")? @map("search_vector")
  metadata      Json?
  createdAt     DateTime            @default(now()) @map("created_at")

  @@index([documentId])
  @@index([parentChunkId])
  @@map("document_chunks")
}

model Faq {
  id         String   @id @default(uuid()) @db.Uuid
  question   String
  answer     String
  questionEn String?  @map("question_en")
  answerEn   String?  @map("answer_en")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("faqs")
}

// ---------- 邮箱验证码（注册/找回） ----------

model EmailCode {
  id        String   @id @default(uuid()) @db.Uuid
  email     String
  code      String
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([email])
  @@map("email_codes")
}

// ---------- AI 对话 ----------
model ChatConversation {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // 发起对话时的产品上下文（slug）
  productContext String?  @map("product_context")
  // 管理端标注状态：normal / flagged / review
  status         String   @default("normal")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  messages ChatMessage[]

  @@index([userId])
  @@map("chat_conversations")
}

model ChatMessage {
  id             String           @id @default(uuid()) @db.Uuid
  conversationId String           @map("conversation_id") @db.Uuid
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  // user / assistant / system 
  role           String
  content        String
  // RAG 引用来源 [{documentId, chunkId, fileName}] 
  sources        Json?
  // 本次回复消耗 token 数 
  tokens         Int?
  createdAt      DateTime         @default(now()) @map("created_at")

  @@index([conversationId])
  @@map("chat_messages")
}
