{
  "name": "hiwhale-platform",
  "version": "0.1.0",
  "private": true,
  "description": "HiWhale Robotics overseas platform monorepo",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "dev:portal": "turbo run dev --filter=portal",
    "dev:admin": "turbo run dev --filter=admin",
    "dev:api": "turbo run dev --filter=@hiwhale/api",
    "dev:all": "turbo run dev",
    "build:portal": "turbo run build --filter=portal",
    "build:admin": "turbo run build --filter=admin",
    "build:api": "turbo run build --filter=@hiwhale/api",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md}\"",
    "db:migrate": "pnpm --filter=@hiwhale/api db:migrate",
    "db:push": "pnpm --filter=@hiwhale/api db:push",
    "db:generate": "pnpm --filter=@hiwhale/api db:generate",
    "db:seed": "pnpm --filter=@hiwhale/api db:seed",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "dev:setup": "bash scripts/dev-up.sh",
    "dev:up": "bash scripts/dev-up.sh && turbo run dev"
  },
  "devDependencies": {
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "sharp": "^0.35.4",
    "turbo": "^2.3.0",
    "typescript": "^5.6.0"
  }
}
